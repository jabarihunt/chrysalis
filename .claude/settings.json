{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh api)",
      "Bash(gh api *)",
      "Bash(gh pr create)",
      "Bash(gh pr create *)",
      "Bash(gh pr new)",
      "Bash(gh pr new *)",
      "Bash(gh pr merge)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review)",
      "Bash(gh pr review *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push * *:master)",
      "Bash(git push * *:master *)",
      "Bash(git push * *:refs/heads/master)",
      "Bash(git push * *:refs/heads/master *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/chrysalis/scripts/hooks/deny-commands.ts\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/chrysalis/scripts/hooks/write-scope.ts\""
          }
        ]
      }
    ]
  }
}
